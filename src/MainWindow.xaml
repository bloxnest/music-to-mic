<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Music to Mic"
    Width="500"
    SizeToContent="Height"
    ResizeMode="CanMinimize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    Foreground="#EEEEF4"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    FontSize="13"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display">

    <!-- Same window system as BloxNest and NudgeNest: the window draws its own frame and shadow (16 px margin)
         so it can fade and scale. Every animation is a short storyboard that only runs while something changes;
         the level meters only update while routing and while the window is open. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="0" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>

        <!-- Title-bar buttons: the hover colour fades in, the icon dips on click -->
        <Style x:Key="CaptionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#2A2A33"/>
            <Setter Property="Foreground" Value="#A6A6B5"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" Background="{TemplateBinding Background}" Opacity="0"/>
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform><ScaleTransform/></ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.82" Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.82" Duration="0:0:0.08"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#EEEEF4"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseCaptionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Background" Value="#C83E45"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Segmented choices: hover and selection fade, tiles press in on click -->
        <Style x:Key="SegmentStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A6A6B5"/>
            <Setter Property="Tag" Value="#A78BFA"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid x:Name="SegmentRoot" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                            <Border x:Name="HoverFill" Background="#2A2A33" CornerRadius="6" Opacity="0"/>
                            <Border x:Name="SelectedFill" Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="6" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#EEEEF4"/>
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#1B1430"/>
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SelectedFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SelectedFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SegmentRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.92" Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetName="SegmentRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.92" Duration="0:0:0.08"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SegmentRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.25">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="SegmentRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.25">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Main buttons: hover brightens, click presses in and springs back -->
        <Style x:Key="LaunchButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#1B1430"/>
            <Setter Property="Background" Value="#A78BFA"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="LaunchRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
                            <Border x:Name="LaunchOverlay" Background="#FFFFFF" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="PressOverlay" Background="#000000" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="LaunchOverlay" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="LaunchOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="LaunchRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetName="LaunchRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.94" Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="0.10" Duration="0:0:0.08"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="LaunchRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="LaunchRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="LaunchRoot" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource LaunchButtonStyle}">
            <Setter Property="Background" Value="#202027"/>
            <Setter Property="Foreground" Value="#EEEEF4"/>
            <Setter Property="BorderBrush" Value="#30303A"/>
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DarkButtonStyle}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Dropdowns: dark box, the list fades open below it -->
        <Style x:Key="ComboItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#D6D6E0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Item" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="3,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Item" Property="Background" Value="#2D2D38"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#C4B2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ChoiceTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Note}" FontSize="11" Foreground="#8F8FA2" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="DarkCombo" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#EEEEF4"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemTemplate" Value="{StaticResource ChoiceTemplate}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="Box" Background="#202027" BorderBrush="#30303A" BorderThickness="1" CornerRadius="7">
                                            <TextBlock x:Name="Chevron" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Text="&#xE70D;" Foreground="#8F8FA2" RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush" Value="#4A4A58"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush" Value="#A78BFA"/>
                                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.18"/>
                                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.18"/>
                                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="12,0,32,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding ItemTemplate}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#202027" BorderBrush="#3A3A46" BorderThickness="1" CornerRadius="7" Margin="0,4,0,8" Padding="0,3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxWidth="460" MaxHeight="320">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Volume sliders: a thin track that fills violet; the knob grows a little on hover and while dragged -->
        <Style x:Key="SliderFill" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#A78BFA" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderEmpty" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Grid Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Width="16" Height="16" Background="Transparent">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#EEEEF4" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.15" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.15" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VolumeSlider" TargetType="{x:Type Slider}">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Height="22" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#2C2C36" VerticalAlignment="Center" Margin="2,0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmpty}"/></Track.IncreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource SliderThumb}"/></Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mute buttons: icon swaps to the "muted" icon (Tag) and turns red -->
        <Style x:Key="MuteToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="#A6A6B5"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" Background="#2A2A33" CornerRadius="6" Opacity="0"/>
                            <Border x:Name="On" Background="#3A2025" CornerRadius="6" Opacity="0"/>
                            <TextBlock x:Name="Normal" Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Muted" Text="{TemplateBinding Tag}" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#EEEEF4"/>
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="Muted" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="Normal" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="Muted" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="Normal" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Options: a row of text with an on/off switch on the right; the knob slides and recolours -->
        <Style x:Key="ToggleRowStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <Border x:Name="Track" Grid.Column="1" Width="40" Height="22" CornerRadius="11" VerticalAlignment="Center" BorderThickness="1">
                                <Border.Background><SolidColorBrush Color="#202027"/></Border.Background>
                                <Border.BorderBrush><SolidColorBrush Color="#3A3A46"/></Border.BorderBrush>
                                <Border x:Name="Knob" Width="14" Height="14" Margin="3,0,0,0" CornerRadius="7" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                                    <Border.Background><SolidColorBrush Color="#A6A6B5"/></Border.Background>
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.15" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.15" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" To="18" Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#A78BFA" Duration="0:0:0.2"/>
                                    <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#A78BFA" Duration="0:0:0.2"/>
                                    <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1B1430" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" To="0" Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#202027" Duration="0:0:0.2"/>
                                    <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#3A3A46" Duration="0:0:0.2"/>
                                    <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#A6A6B5" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#C9C9D6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8F8FA2"/>
        </Style>

        <Style x:Key="OptionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#EEEEF4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="BodyStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#A6A6B5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="HintStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BodyStyle}">
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="ValueText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#A6A6B5"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Level meters: green to -12 dB, yellow to -3 dB, red above, in LED-like segments -->
        <LinearGradientBrush x:Key="MeterColours" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3FCF7A" Offset="0"/>
            <GradientStop Color="#4ADE80" Offset="0.79"/>
            <GradientStop Color="#FACC15" Offset="0.8"/>
            <GradientStop Color="#FACC15" Offset="0.94"/>
            <GradientStop Color="#F87171" Offset="0.95"/>
            <GradientStop Color="#F87171" Offset="1"/>
        </LinearGradientBrush>
        <DrawingBrush x:Key="MeterSegments" TileMode="Tile" Viewport="0,0,5,10" ViewportUnits="Absolute" Viewbox="0,0,5,10" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#00000000" Geometry="M0,0 H5 V10 H0 Z"/>
                    <GeometryDrawing Brush="#16161B" Geometry="M4,0 H5 V10 H4 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Slim scrollbar -->
        <Style x:Key="SlimThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="Transparent">
                            <Border x:Name="Bar" Width="4" CornerRadius="3" HorizontalAlignment="Center" Background="#3A3A46"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="#5A5A6A"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Bar" Property="Background" Value="#A78BFA"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderEmpty}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource SlimThumbStyle}"/></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderEmpty}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#202027"/>
            <Setter Property="Foreground" Value="#EEEEF4"/>
            <Setter Property="BorderBrush" Value="#A78BFA"/>
            <Setter Property="CaretBrush" Value="#EEEEF4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Starts invisible and slightly small; code fades and scales it in. -->
    <Grid x:Name="WindowRoot" Margin="16" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Grid.RenderTransform>

        <Border CornerRadius="10" Background="#16161B" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.5" Color="#000000"/></Border.Effect>
        </Border>

        <Border CornerRadius="10" Background="#16161B" BorderBrush="#2B2B34" BorderThickness="1">
        <Grid x:Name="ContentRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Margin="24,0,0,0" VerticalAlignment="Center" Text="MUSIC TO MIC / FOR ROBLOX" FontSize="10" FontWeight="SemiBold" Foreground="#8F8FA2" IsHitTestVisible="False"/>
                <Button x:Name="SetupButton" Grid.Column="1" Style="{StaticResource CaptionButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True" Content="&#xE897;" ToolTip="Roblox setup" AutomationProperties.Name="Roblox setup"/>
                <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource CaptionButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True" Content="&#xE713;" ToolTip="Settings" AutomationProperties.Name="Settings"/>
                <Button x:Name="MinButton" Grid.Column="3" Style="{StaticResource CaptionButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True" Content="&#xE921;" ToolTip="Minimize to the hidden icons" AutomationProperties.Name="Minimize"/>
                <Button x:Name="CloseButton" Grid.Column="4" Style="{StaticResource CloseCaptionButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True" Content="&#xE8BB;" ToolTip="Close to the hidden icons (keeps routing)" AutomationProperties.Name="Close"/>
            </Grid>

            <Border Grid.Row="1" Padding="24,10,24,22">
                <Grid>
                <!-- The other pages stay Hidden (not Collapsed), so the window keeps one height on every page. -->

                <!-- ============ Main ============ -->
                <StackPanel x:Name="MainPanel" Visibility="Visible">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Canvas Width="256" Height="256">
                                <Canvas.RenderTransform><RotateTransform Angle="-12" CenterX="128" CenterY="128"/></Canvas.RenderTransform>
                                <Path Fill="#9A9AAA" Data="M28,38 H182 V66 H56 V204 H28 Z"/>
                                <Path Fill="#A78BFA" Data="M76,90 H230 V214 H76 Z"/>
                                <Grid Canvas.Left="76" Canvas.Top="90" Width="154" Height="124">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="78" Foreground="#1B1430" Text="&#xF8B1;" VerticalAlignment="Center"/>
                                        <TextBlock Margin="4,0,0,0" FontFamily="Segoe Fluent Icons" FontSize="50" Foreground="#1B1430" Text="&#xE8D6;" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Canvas>
                        </Viewbox>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Music to Mic" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="24" FontWeight="SemiBold" Foreground="#EEEEF4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,1,8,0" VerticalAlignment="Center" Fill="#6B6B7A"/>
                                <TextBlock Text="Status: " FontSize="12" Foreground="#8F8FA2" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" FontWeight="SemiBold" Foreground="#EEEEF4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="StatusDetail" Margin="0,8,0,0" Height="36" Style="{StaticResource BodyStyle}" TextTrimming="CharacterEllipsis" Text=""/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Source" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="SourceBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource DarkCombo}" AutomationProperties.Name="Music source"/>
                        <TextBlock Grid.Row="1" Text="Microphone" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="MicBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource DarkCombo}" AutomationProperties.Name="Microphone"/>
                        <TextBlock Grid.Row="2" Text="Output" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="OutputBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource DarkCombo}" AutomationProperties.Name="Output (virtual microphone)"/>
                        <TextBlock x:Name="OutputHint" Grid.Row="3" Grid.Column="1" Margin="2,4,0,8" FontSize="11" Foreground="#8F8FA2" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="4" Text="Mode" Style="{StaticResource FieldLabel}"/>
                        <Border Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Background="#202027" BorderBrush="#30303A" BorderThickness="1" CornerRadius="8" Padding="2">
                            <UniformGrid x:Name="ModeSegments" Rows="1" Columns="3" Height="32">
                                <RadioButton Style="{StaticResource SegmentStyle}" GroupName="Mode" Content="Music only"/>
                                <RadioButton Style="{StaticResource SegmentStyle}" GroupName="Mode" Content="Mic only"/>
                                <RadioButton Style="{StaticResource SegmentStyle}" GroupName="Mode" Content="Mic + Music"/>
                            </UniformGrid>
                        </Border>
                        <TextBlock Grid.Row="5" Text="Preset" Style="{StaticResource FieldLabel}"/>
                        <Grid Grid.Row="5" Grid.Column="1">
                            <Grid x:Name="PresetPicker">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="PresetBox" Style="{StaticResource DarkCombo}" AutomationProperties.Name="Preset"/>
                                <Button x:Name="SavePresetButton" Grid.Column="1" Margin="8,0,0,0" Height="34" Style="{StaticResource SmallButtonStyle}" Content="Save" ToolTip="Save these volumes as a preset"/>
                            </Grid>
                            <Grid x:Name="PresetNamer" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PresetName" Height="34" MaxLength="24" AutomationProperties.Name="Preset name"/>
                                <Button x:Name="PresetOkButton" Grid.Column="1" Margin="8,0,0,0" Height="34" Style="{StaticResource SmallButtonStyle}" Content="Save"/>
                                <Button x:Name="PresetCancelButton" Grid.Column="2" Margin="6,0,0,0" Height="34" Style="{StaticResource SmallButtonStyle}" Content="Cancel"/>
                            </Grid>
                        </Grid>
                    </Grid>

                    <Border Margin="0,14,0,0" Padding="0,12,0,0" BorderBrush="#2A2A32" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Music volume" Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="MusicSlider" Grid.Column="1" Style="{StaticResource VolumeSlider}" AutomationProperties.Name="Music volume"/>
                            <TextBlock x:Name="MusicValue" Grid.Column="2" Style="{StaticResource ValueText}" Text="50%"/>
                            <ToggleButton x:Name="MuteMusicButton" Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource MuteToggle}" Content="&#xE8D6;" Tag="&#xE74F;" ToolTip="Mute music" AutomationProperties.Name="Mute music"/>
                            <TextBlock Grid.Row="1" Text="Mic volume" Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="MicSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource VolumeSlider}" AutomationProperties.Name="Microphone volume"/>
                            <TextBlock x:Name="MicValue" Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}" Text="100%"/>
                            <ToggleButton x:Name="MuteMicButton" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource MuteToggle}" Content="&#xE720;" Tag="&#xF781;" ToolTip="Mute mic" AutomationProperties.Name="Mute microphone"/>
                            <TextBlock Grid.Row="2" Text="Master" Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="MasterSlider" Grid.Row="2" Grid.Column="1" Style="{StaticResource VolumeSlider}" AutomationProperties.Name="Master volume"/>
                            <TextBlock x:Name="MasterValue" Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueText}" Text="100%"/>
                            <ToggleButton x:Name="MuteAllButton" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource MuteToggle}" Content="&#xE767;" Tag="&#xE74F;" ToolTip="Mute all" AutomationProperties.Name="Mute all"/>
                        </Grid>
                    </Border>

                    <Border Margin="0,10,0,0" Padding="0,12,0,0" BorderBrush="#2A2A32" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <CheckBox x:Name="PushToggle" Style="{StaticResource ToggleRowStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Push-to-music"/>
                                    <TextBlock x:Name="PushHint" Style="{StaticResource HintStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Music only goes out while you hold F8."/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="MonitorToggle" Style="{StaticResource ToggleRowStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Monitor output"/>
                                    <TextBlock x:Name="MonitorHint" Style="{StaticResource HintStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Hear exactly what Roblox gets, on your speakers."/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StartButton" Style="{StaticResource LaunchButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Text="&#xE768;"/>
                                <TextBlock x:Name="StartText" VerticalAlignment="Center" Text="Start routing"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopButton" Grid.Column="2" Style="{StaticResource DarkButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Text="&#xE71A;"/>
                                <TextBlock VerticalAlignment="Center" Text="Stop"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="#2A2A32" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="58"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="MUSIC" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
                            <Grid x:Name="MusicMeter" Grid.Column="1" Height="10" VerticalAlignment="Center">
                                <Border CornerRadius="3" Background="{StaticResource MeterColours}"/>
                                <Border x:Name="MusicMeterCover" CornerRadius="3" Background="#24242C"/>
                                <Border x:Name="MusicMeterPeak" Width="2" HorizontalAlignment="Left" Background="#EEEEF4" Opacity="0"/>
                                <Border CornerRadius="3" Background="{StaticResource MeterSegments}" IsHitTestVisible="False"/>
                            </Grid>
                            <TextBlock x:Name="MusicDb" Grid.Column="2" Style="{StaticResource ValueText}" FontSize="11" Text="-&#x221E; dB"/>
                            <TextBlock Grid.Row="1" Text="MIC" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
                            <Grid x:Name="MicMeter" Grid.Row="1" Grid.Column="1" Height="10" VerticalAlignment="Center">
                                <Border CornerRadius="3" Background="{StaticResource MeterColours}"/>
                                <Border x:Name="MicMeterCover" CornerRadius="3" Background="#24242C"/>
                                <Border x:Name="MicMeterPeak" Width="2" HorizontalAlignment="Left" Background="#EEEEF4" Opacity="0"/>
                                <Border CornerRadius="3" Background="{StaticResource MeterSegments}" IsHitTestVisible="False"/>
                            </Grid>
                            <TextBlock x:Name="MicDb" Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}" FontSize="11" Text="-&#x221E; dB"/>
                            <TextBlock Grid.Row="2" Text="OUTPUT" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
                            <Grid x:Name="OutMeter" Grid.Row="2" Grid.Column="1" Height="10" VerticalAlignment="Center">
                                <Border CornerRadius="3" Background="{StaticResource MeterColours}"/>
                                <Border x:Name="OutMeterCover" CornerRadius="3" Background="#24242C"/>
                                <Border x:Name="OutMeterPeak" Width="2" HorizontalAlignment="Left" Background="#EEEEF4" Opacity="0"/>
                                <Border CornerRadius="3" Background="{StaticResource MeterSegments}" IsHitTestVisible="False"/>
                            </Grid>
                            <TextBlock x:Name="OutDb" Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueText}" FontSize="11" Text="-&#x221E; dB"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="LimitText" Margin="64,4,0,0" FontSize="11" Foreground="#F87171" Opacity="0" Text="Limiting: the mix was too loud, so it was turned down to stop clipping."/>
                </StackPanel>

                <!-- ============ Settings ============ -->
                <StackPanel x:Name="SettingsPanel" Visibility="Hidden">
                    <Grid Margin="0,4,0,16">
                        <Button x:Name="SettingsBackButton" Style="{StaticResource SmallButtonStyle}" Content="&#x2190; Back" AutomationProperties.Name="Back"/>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="SETTINGS" Style="{StaticResource CaptionStyle}"/>
                    </Grid>
                    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="WHEN THE APP OPENS, USE" Style="{StaticResource CaptionStyle}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Source" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="DefaultSourceBox" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource DarkCombo}" AutomationProperties.Name="Default music source"/>
                            <TextBlock Grid.Row="1" Text="Microphone" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="DefaultMicBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource DarkCombo}" AutomationProperties.Name="Default microphone"/>
                            <TextBlock Grid.Row="2" Text="Output" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="DefaultOutputBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource DarkCombo}" AutomationProperties.Name="Default output"/>
                        </Grid>

                        <Border Margin="0,16,0,0" Padding="0,14,0,14" BorderBrush="#2A2A32" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Push-to-music key"/>
                                    <TextBlock x:Name="KeyHint" Style="{StaticResource HintStyle}" Text="Keys and mouse buttons 4/5 work. Nothing is blocked: Roblox still gets the key." RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock x:Name="KeyValueText" Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Text="F8" FontSize="13" FontWeight="SemiBold" Foreground="#EEEEF4"/>
                                <Button x:Name="ChangeKeyButton" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SmallButtonStyle}" Content="Change"/>
                            </Grid>
                        </Border>

                        <Border Padding="0,14,0,0" BorderBrush="#2A2A32" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,12" Text="STARTUP" Style="{StaticResource CaptionStyle}"/>
                                <CheckBox x:Name="OptStartMinimized" Style="{StaticResource ToggleRowStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Start minimized"/>
                                        <TextBlock Style="{StaticResource HintStyle}" Text="Opens straight to the hidden icons."/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="OptWindows" Style="{StaticResource ToggleRowStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Start with Windows"/>
                                        <TextBlock Style="{StaticResource HintStyle}" Text="Opens minimized when you sign in."/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="OptRouteAtLaunch" Style="{StaticResource ToggleRowStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Start routing when the app opens"/>
                                        <TextBlock Style="{StaticResource HintStyle}" Text="Uses the source, mic and output above."/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Padding="0,14,0,0" BorderBrush="#2A2A32" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,12" Text="DEVICES AND MEMORY" Style="{StaticResource CaptionStyle}"/>
                                <CheckBox x:Name="OptAutoReconnect" Style="{StaticResource ToggleRowStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Reconnect devices automatically"/>
                                        <TextBlock Style="{StaticResource HintStyle}" Text="If a device is unplugged, routing resumes when it's back."/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="OptRememberVolumes" Style="{StaticResource ToggleRowStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Remember volume levels"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="OptRememberMode" Style="{StaticResource ToggleRowStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Remember the mode"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Padding="0,14,0,14" BorderBrush="#2A2A32" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Your presets"/>
                                <TextBlock x:Name="PresetListText" Style="{StaticResource HintStyle}" Text="None yet. Set the volumes, then press Save next to Preset."/>
                                <Grid x:Name="SavedPresetRow" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="SavedPresetBox" Style="{StaticResource DarkCombo}" AutomationProperties.Name="Your presets"/>
                                    <Button x:Name="DeletePresetButton" Grid.Column="1" Margin="8,0,0,0" Height="34" Style="{StaticResource SmallButtonStyle}" Content="Delete"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Padding="0,14,0,0" BorderBrush="#2A2A32" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Activity log"/>
                                    <TextBlock Style="{StaticResource HintStyle}" Text="Devices, sources, routing and errors. Never any audio."/>
                                </StackPanel>
                                <Button x:Name="ViewLogButton" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SmallButtonStyle}" Content="View"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="AboutText" Margin="0,18,0,0" FontSize="11" Foreground="#6E6E80" Text="Music to Mic 1.0.0 · Made by xRed1"/>
                    </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <!-- ============ Roblox setup ============ -->
                <StackPanel x:Name="SetupPanel" Visibility="Hidden">
                    <Grid Margin="0,4,0,16">
                        <Button x:Name="SetupBackButton" Style="{StaticResource SmallButtonStyle}" Content="&#x2190; Back" AutomationProperties.Name="Back"/>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="ROBLOX SETUP" Style="{StaticResource CaptionStyle}"/>
                    </Grid>
                    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly">
                    <StackPanel Margin="0,0,10,0">
                        <Border x:Name="CableCard" Background="#202027" BorderBrush="#30303A" BorderThickness="1" CornerRadius="9" Padding="16,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="CableIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#4ADE80" Text="&#xE73E;"/>
                                    <TextBlock x:Name="CableTitle" Style="{StaticResource OptionTitleStyle}" VerticalAlignment="Center" Text="Virtual microphone found"/>
                                </StackPanel>
                                <TextBlock x:Name="CableText" Margin="0,8,0,0" Style="{StaticResource BodyStyle}" Text=""/>
                                <StackPanel x:Name="CableButtons" Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="CableDownloadButton" Style="{StaticResource SmallButtonStyle}" Content="Get VB-CABLE (free)"/>
                                    <Button x:Name="SoundSettingsButton" Margin="8,0,0,0" Style="{StaticResource SmallButtonStyle}" Content="Windows sound settings"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,18,0,10" Text="STEPS" Style="{StaticResource CaptionStyle}"/>
                        <TextBlock Style="{StaticResource BodyStyle}" Foreground="#C9C9D6" LineHeight="24">
                            <Run Text="1.  Start Music to Mic."/><LineBreak/>
                            <Run Text="2.  Pick the music source (play a song first so it shows up)."/><LineBreak/>
                            <Run Text="3.  Pick your real microphone."/><LineBreak/>
                            <Run Text="4.  Press Start routing."/><LineBreak/>
                            <Run Text="5.  Open Roblox."/><LineBreak/>
                            <Run Text="6.  In Roblox, open Settings and find the microphone (input device)."/><LineBreak/>
                            <Run x:Name="StepSeven" Text="7.  Pick CABLE Output as the microphone."/>
                        </TextBlock>

                        <Border Margin="0,18,0,0" Padding="0,14,0,0" BorderBrush="#2A2A32" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Good to know"/>
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStyle}" Text="Roblox push-to-talk works as normal: Music to Mic is just a microphone to Roblox."/>
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStyle}" Text="Only the app you pick is sent. Discord pings and Windows sounds aren't."/>
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStyle}" Text="Music to Mic never touches Roblox: no injection, no files, no memory. It's a normal Windows audio app."/>
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStyle}" Text="Follow Roblox's rules for voice chat and only play music you're allowed to share."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <!-- ============ Activity log ============ -->
                <StackPanel x:Name="LogPanel" Visibility="Hidden">
                    <Grid Margin="0,4,0,16">
                        <Button x:Name="LogBackButton" Style="{StaticResource SmallButtonStyle}" Content="&#x2190; Back" AutomationProperties.Name="Back"/>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="ACTIVITY LOG" Style="{StaticResource CaptionStyle}"/>
                    </Grid>
                    <Border Background="#1C1C22" BorderBrush="#2B2B34" BorderThickness="1" CornerRadius="8" Padding="12,10,4,10">
                        <ScrollViewer x:Name="LogScroll" Height="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                            <TextBlock x:Name="LogText" Margin="0,0,8,0" FontFamily="Cascadia Mono, Consolas" FontSize="11" LineHeight="18" Foreground="#A6A6B5" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                    <Grid Margin="0,14,0,0">
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#8F8FA2" Text="Only the newest entries are kept."/>
                        <Button x:Name="OpenLogButton" HorizontalAlignment="Right" Style="{StaticResource SmallButtonStyle}" Content="Open log file"/>
                    </Grid>
                </StackPanel>

                </Grid>
            </Border>
        </Grid>
        </Border>
    </Grid>
</Window>
